#!/usr/bin/env bash
set -euo pipefail

readonly root_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
readonly source_volume="${IMMORTALWRT_VOLUME:-immortalwrt-24.10.5-src}"
readonly builder_image="${IMMORTALWRT_IMAGE:-immortalwrt-24.10.5-builder}"
readonly container_platform="${IMMORTALWRT_PLATFORM:-linux/amd64}"
readonly build_jobs="${IMMORTALWRT_JOBS:-$(nproc)}"
readonly source_url="https://github.com/immortalwrt/immortalwrt.git"
readonly source_tag="v24.10.5"
readonly source_commit="b2bdbd942bbadb80e93d12fca423d53cc70ab22c"

usage() {
	cat <<'EOF'
Usage: scripts/immortalwrt <init|shell|build|export|clean>

  init    Build the Linux builder image and clone the pinned ImmortalWrt source.
  shell   Open a shell in the pinned source volume.
  build   Run defconfig, download sources, and compile the custom firmware.
  export  Copy EFI images, manifests, and checksums into output/.
  clean   Remove generated build output while preserving the source and downloads.
EOF
}

require_docker() {
	docker info >/dev/null 2>&1 || {
		echo "Docker Desktop is not running or is not accessible." >&2
		exit 1
	}
}

container() {
	docker run --rm --platform "$container_platform" \
		--user 1000:1000 \
		-v "$source_volume:/src" \
		-v "$root_dir:/project:ro" \
		-w /src "$builder_image" "$@"
}

prepare_source() {
	container bash -ceu "
		if [ ! -d .git ]; then
			git clone --branch '$source_tag' --depth 1 '$source_url' .
		fi
		actual=\$(git rev-parse HEAD)
		[ \"\$actual\" = '$source_commit' ] || {
			echo \"Expected $source_commit, found \$actual\" >&2
			exit 1
		}
		cp /project/config/feeds.conf.default feeds.conf.default
		./scripts/feeds update -a
		./scripts/feeds install -a
		cp /project/config/immortalwrt-x86_64.config .config
		cp -a /project/files/. files/
		chmod 0755 files/etc/init.d/expand-rootfs
	"
}

init() {
	require_docker
	docker build --platform "$container_platform" -t "$builder_image" "$root_dir/docker"
	docker volume create "$source_volume" >/dev/null
	docker run --rm --platform "$container_platform" --user root -v "$source_volume:/src" "$builder_image" \
		chown -R 1000:1000 /src
	prepare_source
}

build() {
	require_docker
	[[ "$build_jobs" =~ ^[1-9][0-9]*$ ]] || {
		echo "IMMORTALWRT_JOBS must be a positive integer." >&2
		exit 64
	}
	container test -d .git || {
		echo "Source is not initialized. Run: scripts/immortalwrt init" >&2
		exit 1
	}
	container bash -ceu '
		cp /project/config/immortalwrt-x86_64.config .config
		cp -a /project/files/. files/
		chmod 0755 files/etc/init.d/expand-rootfs
		make defconfig
		make download -j"'$build_jobs'"
		make -j"'$build_jobs'"
	'
}

export_images() {
	require_docker
	mkdir -p "$root_dir/output"
	docker run --rm --platform "$container_platform" \
		--user 1000:1000 \
		-v "$source_volume:/src" \
		-v "$root_dir/output:/output" \
		-w /src "$builder_image" bash -ceu '
		shopt -s nullglob
		artifacts=(bin/targets/x86/64/*combined-efi*.img.gz bin/targets/x86/64/*combined-efi*.qcow2.gz)
		[ "${#artifacts[@]}" -gt 0 ] || { echo "No EFI artifacts found; build first." >&2; exit 1; }
		cp "${artifacts[@]}" /output/
		cp bin/targets/x86/64/*.manifest bin/targets/x86/64/sha256sums /output/ 2>/dev/null || true
	'
}

clean() {
	require_docker
	container make clean
}

case "${1:-}" in
	init) init ;;
	shell)
		require_docker
		docker run --rm -it --platform "$container_platform" --user 1000:1000 \
			-v "$source_volume:/src" -w /src "$builder_image" bash
		;;
	build) build ;;
	export) export_images ;;
	clean) clean ;;
	*) usage; exit 64 ;;
esac
